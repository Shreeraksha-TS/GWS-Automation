# These MUST match HOST_DATA_DIR / HOST_REPORTS_DIR / HOST_SCRIPTS_DIR in the API .env.
DATA_DIR=C:\rpa-platform\data
REPORTS_DIR=C:\rpa-platform\reports
SCRIPTS_DIR=C:\rpa-platform\scripts

# Worker behaviour
WORKER_POLL_INTERVAL=3          # seconds between job-queue polls
WORKER_HEADLESS=true            # set false to watch the browser run on the desktop
