# Storage: HOST folder bind-mounted into the API container.
# Inside the container this is always /app/data (see docker-compose.yml).
DATA_DIR=/app/data

# Backend
SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# Scripts & Reports (paths INSIDE the container)
SCRIPTS_DIR=/app/scripts
REPORTS_DIR=/app/reports

# Frontend (build time)
VITE_API_BASE_URL=http://localhost:8000

# Host folders the container bind-mounts (set on the Windows host).
# These same Windows paths are what the native worker uses below.
HOST_DATA_DIR=C:\rpa-platform\data
HOST_REPORTS_DIR=C:\rpa-platform\reports
HOST_SCRIPTS_DIR=C:\rpa-platform\scripts
